# OpenWA backend settings for use with the NecxaWA console.
# Copy to the OpenWA repo directory as `.env` and adjust.
# Full reference: https://github.com/rmyndharis/OpenWA/blob/main/.env.example

# Port the API listens on (console default base URL assumes 2785)
API_PORT=2785

# First-boot admin key. If unset, OpenWA generates a random one and prints it
# in `docker logs openwa-api` (also written to data/.api-key).
# Set your own to keep it stable across reinstalls:
# API_MASTER_KEY=change-me-to-something-long-and-random

# Comma-separated origins allowed to call the API from a browser.
# Needed when the console (e.g. https://luczz7.github.io) and the backend
# are on different hosts. For local testing with the console on this page:
# CORS_ORIGINS=https://luczz7.github.io
CORS_ORIGINS=

# WhatsApp engine: whatsapp-web.js (default) or baileys
# ENGINE_TYPE=

# Re-start previously paired sessions automatically on boot
# AUTO_START_SESSIONS=true
